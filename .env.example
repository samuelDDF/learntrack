MONGO_URI=
# ---- Frontend (Vite; URL pública de la API, vacía en desarrollo same-origin) ----
VITE_API_URL=
VITE_BASE_PATH=/learntrack/

# ---- Servidor ----
PORT=3000
# development | production (en producción la cookie de sesión lleva «Secure»: necesitas HTTPS)
NODE_ENV=development
# Origen(es) exacto(s) del frontend publicado, separados por comas. Ej.: https://usuario.github.io
ALLOWED_ORIGINS=
# Cookie entre frontend y API: Strict funciona con dominios propios del mismo sitio (app.midominio.com + api.midominio.com).
# None permite intentar cross-site con github.io + railway.app, pero navegadores pueden bloquear cookies de terceros.
COOKIE_SAME_SITE=Strict
# true cuando Express solo publica /api y GitHub Pages sirve el frontend estático
API_ONLY=false
# Número de proxies de confianza delante de Express (p. ej. 1 detrás de Nginx o de un balanceador con HTTPS)
TRUST_PROXY=
# Zona horaria por defecto si el navegador no envía la suya
ZONA_HORARIA=America/Bogota
# Días que se guarda lo eliminado en la papelera
PAPELERA_DIAS=30

# ---- Correo: verificación de cuentas nuevas con código de 6 dígitos (v3.10) ----
# Servidor SMTP (Gmail, Outlook, Brevo, Mailgun, Amazon SES…). Sin SMTP_HOST:
#   · en desarrollo los correos se guardan como .eml en la carpeta correos-dev/ (no se envían)
#   · en producción (NODE_ENV=production) el registro de cuentas nuevas queda desactivado
SMTP_HOST=smtp.gmail.com
# 587 con STARTTLS (SMTP_SECURE=false) o 465 con TLS directo (SMTP_SECURE=true)
SMTP_PORT=465
SMTP_SECURE=true
# Usuario y contraseña del SMTP. En Gmail usa una «contraseña de aplicación», nunca tu contraseña normal.
SMTP_USER=sel121957@gmail.com
SMTP_PASS=
# Remitente que verá la persona. Ejemplo: LearnTrack <no-responder@tudominio.com>
SMTP_FROM=LearnTrack <sel121957@gmail.com>
# Opcional: en producción se exige STARTTLS si SMTP_SECURE=false; pon false solo si tu servidor no lo admite
SMTP_REQUIRE_TLS=
# Validez del código (minutos, 1–60), intentos fallidos por código (1–10), espera entre envíos (segundos)
# y máximo de códigos por correo y hora
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Cuentas creadas ANTES de la v3.10 (sin verificar): permitir (conservan el acceso) | exigir (verifican al entrar)
VERIFICACION_CUENTAS_ANTIGUAS=permitir

# ---- Asistente de IA (Ollama, solo lo usa el servidor) ----
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Opcional: modelo de visión para leer imágenes (p. ej. llama3.2-vision)
OLLAMA_VISION_MODEL=llama3.2-vision
# Opcional: clave si tu Ollama está detrás de un proxy con autenticación
OLLAMA_API_KEY=ollama_local
OLLAMA_TIMEOUT_MS=60000

# ---- Intermediario local de Ollama (solo en TU equipo; npm run ia:intermediario) ----
# Clave que exige el intermediario. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERMEDIARIO_CLAVE=
INTERMEDIARIO_MODELOS=llama3.2
INTERMEDIARIO_MAX_BYTES=8000000
# Opcionales (valores por defecto entre paréntesis)
# INTERMEDIARIO_PUERTO=11435
# INTERMEDIARIO_OLLAMA_URL=http://127.0.0.1:11434
# INTERMEDIARIO_MODELOS=llama3.2
# INTERMEDIARIO_MAX_BYTES=1000000
# INTERMEDIARIO_POR_MINUTO=60
# INTERMEDIARIO_SIMULTANEAS=3
# INTERMEDIARIO_TIMEOUT_MS=90000


# ---- Servicios externos (opcionales; hay valores por defecto) ----
NAGER_API_URL=
COLORMIND_API_URL=
# Cuentas vinculadas: simulado (por defecto fuera de producción) | desactivado (por defecto en producción)
INTEGRACIONES_MODO=

# ---- v3.13: documentos legales, menores y administrador único ----
# Dirección pública de LearnTrack (sin barra final). Se usa para el enlace que recibe por correo el representante
# legal de un menor (…/autorizacion-representante#t=…). En Railway, la URL pública de la app.
URL_PUBLICA_APP=
# Correo del ADMINISTRADOR ÚNICO. Solo lo leen los scripts «npm run admin:crear | admin:verificar | admin:restablecer»
# (el servidor web no lo necesita). Debe ser un correo distinto del de cualquier cuenta normal.
# La CONTRASEÑA del administrador NUNCA va aquí: el script la pide en la consola, oculta y dos veces.
ADMIN_EMAIL=
# Nombre visible del administrador (opcional; por defecto «Administración»)
ADMIN_NOMBRE=

{
  "name": "learntrack",
  "version": "3.6.0",
  "description": "LearnTrack: planificador de carga mental con asistente de IA local (Ollama), frontend React + PWA, agenda, proyectos, repaso espaciado, propuestas confirmables, papelera, voz y archivos (MongoDB Atlas)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/desarrollo.js",
    "dev:api": "node server.js",
    "dev:web": "vite --config frontend-react/vite.config.js",
    "build": "vite build --config frontend-react/vite.config.js",
    "test": "node tests/ejecutar.js",
    "test:front": "vitest run --config frontend-react/vite.config.js",
    "test:todo": "npm run build && npm test && npm run test:front",
    "test:e2e": "node tests/navegador/prueba-navegador.js",
    "test:e2e:react": "node tests/navegador/prueba-react.js",
    "migrar:datos": "node scripts/importar-datos-json.js",
    "zip": "node scripts/generar-zip.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "~5.4.296"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~6.6.3",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.6.1",
    "@vitejs/plugin-react": "~4.5.0",
    "archiver": "^7.0.1",
    "bson": "^6.10.4",
    "jsdom": "~26.1.0",
    "mingo": "^7.2.4",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-router": "7.18.4",
    "vite": "6.4.4",
    "vite-plugin-pwa": "~1.0.0",
    "vitest": "3.2.7"
  }
}

PORT=3000

# Clave de Gemini (https://aistudio.google.com/apikey). Solo la usa el servidor; nunca llega al navegador.
GEMINI_API_KEY=tu_clave_aqui

# Opcional: Google retira modelos con frecuencia; cámbialo aquí si da error 404
GEMINI_MODEL=gemini-3.5-flash

# Opcional: otros orígenes autorizados por CORS, separados por comas (por defecto solo el propio sitio)
# ALLOWED_ORIGINS=https://midominio.com

# Producción (HTTPS): marca la cookie de sesión como Secure
# NODE_ENV=production

# Producción detrás de un proxy inverso: número de proxies de confianza
# TRUST_PROXY=1
